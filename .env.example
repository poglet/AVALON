# AVALON environment configuration
# Copy this file to `.env` and fill in the values.
# Only the API key is required; everything else has sensible defaults and can
# also be set in `.avalon/config.toml` (see the plan for the config split).

# Required: your OpenRouter API key.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (normally set in .avalon/config.toml instead).
# AVALON_MODEL=deepseek/deepseek-v4.1-flash
# AVALON_BACKUP_MODEL=
# AVALON_MAX_STEPS=40
# AVALON_MAX_TIME_MINUTES=
